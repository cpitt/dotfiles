{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@howaboua/opencode-usage-plugin"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
    },
  },
  "experimental": {
    "disable_paste_summary": true,
  },
}
