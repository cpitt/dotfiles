# Legacy single-profile directory retained temporarily for rollback/runtime state.
/agent/

# Credentials and private data
/profiles/*/auth.json
/profiles/*/mcp-oauth/
/profiles/*/sessions/

# Installed and generated packages
/profiles/*/npm/
/profiles/*/git/

# Caches
/web-search-cache/
/profiles/*/cache/
/profiles/*/*-cache.json

# Generated provider/model metadata
/profiles/*/models-store.json

# Machine-specific and transient state
/profiles/*/trust.json
/profiles/*/*-state.json
/profiles/*/*-changelog.json
/profiles/*/mcp-onboarding.json
/profiles/*/extensions/herdr-agent-state.ts
/profiles/*/shepherdr/.profiles-initialized

# Common temporary output
/profiles/*/logs/
/profiles/*/tmp/
*.log
*.tmp
*.bak
